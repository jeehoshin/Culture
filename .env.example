# External cultural APIs (server only)
KOPIS_API_KEY=
CULTURE_PORTAL_API_KEY=
CULTURE_PORTAL_API_URL=https://api.kcisa.kr/openapi/API_CCA_145/request
SEOUL_OPEN_API_KEY=

# Supabase (server only except publishable/public URL)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Recommended server key (sb_secret_...). Legacy service-role remains supported below.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sync endpoint protection
SYNC_SECRET=change-me

# Runtime
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USE_FIXTURE_DATA=true
SYNC_KOPIS_ENABLED=true
SYNC_CULTURE_PORTAL_ENABLED=true
CULTURE_PORTAL_MAX_PAGES=100
SUPABASE_FETCH_LIMIT=5000

